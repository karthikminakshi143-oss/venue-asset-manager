{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "venue-asset-manager": {
      "root": "venue-asset-manager",
      "framework": "vite",
      "bindings": [
        {
          "type": "service",
          "service": "server",
          "format": "url",
          "env": "API_BASE_URL"
        }
      ]
    },
    "server": {
      "root": "venue-asset-manager/server",
      "framework": "express"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "server",
        "path": "/$1"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "venue-asset-manager"
      }
    }
  ]
}
