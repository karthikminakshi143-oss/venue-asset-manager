import express from 'express';
import cors from 'cors';
import jwt from 'jsonwebtoken';
import bcrypt from 'bcryptjs';
import mysql from 'mysql2/promise';
import fs from 'fs';
import path from 'path';
import { fileURLToPath } from 'url';
import dotenv from 'dotenv';

dotenv.config();
const __dirname = path.dirname(fileURLToPath(import.meta.url));
const PORT = Number(process.env.PORT || 4000);
const JWT_SECRET = process.env.JWT_SECRET || 'CHANGE_THIS_SECRET_IN_PRODUCTION';
const app = express();
app.use(cors({origin:true,credentials:true}));
app.use(express.json({limit:'40mb'}));

const pool=mysql.createPool({host:process.env.DB_HOST||'127.0.0.1',port:Number(process.env.DB_PORT||3306),user:process.env.DB_USER||'root',password:process.env.DB_PASSWORD||'',database:process.env.DB_NAME||'venue_asset_manager',waitForConnections:true,connectionLimit:10,charset:'utf8mb4'});

function publicUser(u){const {password_hash,passwordHash,...safe}=u;return safe}
function tokenFor(u){return jwt.sign({id:u.id,email:u.email,role:u.role},JWT_SECRET,{expiresIn:'12h'})}
function auth(req,res,next){const h=req.headers.authorization||'';const t=h.startsWith('Bearer ')?h.slice(7):'';if(!t)return res.status(401).json({error:'Authentication required'});try{req.user=jwt.verify(t,JWT_SECRET);next()}catch{return res.status(401).json({error:'Invalid or expired token'})}}
function admin(req,res,next){if(req.user.role!=='Admin')return res.status(403).json({error:'Administrator access required'});next()}

async function initDb(){
 await pool.query(`CREATE TABLE IF NOT EXISTS users (id VARCHAR(100) NOT NULL PRIMARY KEY,name VARCHAR(150) NOT NULL,email VARCHAR(190) NOT NULL UNIQUE,password_hash VARCHAR(255) NOT NULL,role VARCHAR(50) NOT NULL,permissions TEXT NULL,created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4`);
 await pool.query(`CREATE TABLE IF NOT EXISTS venue_master (id VARCHAR(100) NOT NULL PRIMARY KEY,venue_id VARCHAR(100) NOT NULL UNIQUE,name VARCHAR(200) NOT NULL,state VARCHAR(120) NOT NULL,state_code VARCHAR(20) NULL,district VARCHAR(120) NOT NULL,district_code VARCHAR(20) NULL,location VARCHAR(255) NULL,contact VARCHAR(30) NULL,address TEXT NULL,updated_by VARCHAR(190) NULL,created_by VARCHAR(190) NULL,created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4`);
 await pool.query(`CREATE TABLE IF NOT EXISTS asset_master (id VARCHAR(100) NOT NULL PRIMARY KEY,venue_id VARCHAR(100) NOT NULL,asset_type ENUM('Own','Rental') NOT NULL DEFAULT 'Own',category VARCHAR(120) NOT NULL,model_name VARCHAR(200) NULL,serial_number VARCHAR(200) NULL,quantity INT NOT NULL DEFAULT 1,details VARCHAR(255) NULL,invoice_no VARCHAR(150) NULL,invoice_date DATE NULL,vendor_name VARCHAR(200) NULL,removal_date DATE NULL,removed TINYINT(1) NOT NULL DEFAULT 0,updated_by VARCHAR(190) NULL,created_by VARCHAR(190) NULL,created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,INDEX idx_asset_venue(venue_id),INDEX idx_asset_category(category),INDEX idx_asset_type(asset_type)) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4`);
 await pool.query(`CREATE TABLE IF NOT EXISTS asset_letters (id VARCHAR(100) NOT NULL PRIMARY KEY,venue_id VARCHAR(100) NOT NULL,letter_date DATE NOT NULL,file_name VARCHAR(255) NOT NULL,mime_type VARCHAR(150) NULL,file_size BIGINT NOT NULL DEFAULT 0,file_data LONGBLOB NOT NULL,uploaded_by VARCHAR(190) NULL,created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,INDEX idx_letter_venue(venue_id),INDEX idx_letter_date(letter_date)) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4`);
 const [u]=await pool.query('SELECT COUNT(*) c FROM users');
 if(Number(u[0].c)===0){const hash=bcrypt.hashSync(process.env.ADMIN_PASSWORD||'admin123',10);await pool.query('INSERT INTO users(id,name,email,password_hash,role,permissions) VALUES(?,?,?,?,?,?)',['1','Administrator','admin@venueassetmanager.local',hash,'Admin',JSON.stringify(['dashboard','venues','assets','letters','reports','calculator','users'])]);}
 await migrateLegacyJsonTables();
 await migrateDataJson();
}

async function migrateLegacyJsonTables(){
 try{
  const [vt]=await pool.query("SHOW TABLES LIKE 'venues'");
  if(vt.length){const [rows]=await pool.query('SELECT id,data_json FROM venues');for(const r of rows){try{const x=JSON.parse(r.data_json);await upsertVenue(x.id||r.id,x)}catch{}}}
  const [at]=await pool.query("SHOW TABLES LIKE 'assets'");
  if(at.length){const [rows]=await pool.query('SELECT id,data_json FROM assets');for(const r of rows){try{const x=JSON.parse(r.data_json);await upsertAsset(r.id,x)}catch{}}}
 }catch(e){console.warn('Legacy SQL migration skipped:',e.message)}
}
async function migrateDataJson(){
 try{const p=path.join(__dirname,'data.json');if(!fs.existsSync(p))return;const d=JSON.parse(fs.readFileSync(p,'utf8'));const [v]=await pool.query('SELECT COUNT(*) c FROM venue_master');if(Number(v[0].c)===0){for(const x of d.venues||[])await upsertVenue(x.id,x)}const [a]=await pool.query('SELECT COUNT(*) c FROM asset_master');if(Number(a[0].c)===0){for(const x of d.assets||[])await upsertAsset(x.id,x)}}catch(e){console.warn('data.json migration skipped:',e.message)}
}
async function upsertVenue(id,x){const q=`INSERT INTO venue_master(id,venue_id,name,state,state_code,district,district_code,location,contact,address,updated_by,created_by) VALUES(?,?,?,?,?,?,?,?,?,?,?,?) ON DUPLICATE KEY UPDATE venue_id=VALUES(venue_id),name=VALUES(name),state=VALUES(state),state_code=VALUES(state_code),district=VALUES(district),district_code=VALUES(district_code),location=VALUES(location),contact=VALUES(contact),address=VALUES(address),updated_by=VALUES(updated_by),created_by=VALUES(created_by)`;await pool.query(q,[id||crypto.randomUUID(),x.venueId||id||'',x.name||'',x.state||'',x.stateCode||'',x.district||'',x.districtCode||'',x.location||'',x.contact||'',x.address||'',x.updatedBy||'',x.createdBy||''])}
async function upsertAsset(id,x){let venueId=x.venueId||'';const [v]=await pool.query('SELECT id FROM venue_master WHERE id=? OR venue_id=? LIMIT 1',[venueId,venueId]);if(v[0])venueId=v[0].id;const q=`INSERT INTO asset_master(id,venue_id,asset_type,category,model_name,serial_number,quantity,details,invoice_no,invoice_date,vendor_name,removal_date,removed,updated_by,created_by) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?) ON DUPLICATE KEY UPDATE venue_id=VALUES(venue_id),asset_type=VALUES(asset_type),category=VALUES(category),model_name=VALUES(model_name),serial_number=VALUES(serial_number),quantity=VALUES(quantity),details=VALUES(details),invoice_no=VALUES(invoice_no),invoice_date=VALUES(invoice_date),vendor_name=VALUES(vendor_name),removal_date=VALUES(removal_date),removed=VALUES(removed),updated_by=VALUES(updated_by),created_by=VALUES(created_by)`;await pool.query(q,[id||crypto.randomUUID(),venueId,x.assetType||'Own',x.category||'Other',x.modelName||x.model||'',x.serial||'',Number(x.quantity||1),x.details||'',x.invoiceNo||'',x.invoiceDate||null,x.vendorName||'',x.removalDate||null,x.removed?1:0,x.updatedBy||'',x.createdBy||''])}

app.get('/api/health',async(req,res)=>{try{await pool.query('SELECT 1');res.json({ok:true,service:'venue-asset-manager-api',database:'mysql'})}catch(e){res.status(500).json({ok:false,error:e.message})}});
app.post('/api/auth/login',async(req,res)=>{try{const email=String(req.body?.email||'').trim().toLowerCase(),password=String(req.body?.password||'');if(!/^\S+@\S+\.\S+$/.test(email))return res.status(400).json({error:'Valid email ID is required'});if(password.length<6||password.length>10)return res.status(400).json({error:'Password must be 6 to 10 characters'});const [r]=await pool.query('SELECT * FROM users WHERE email=? LIMIT 1',[email]);const u=r[0];if(!u||!bcrypt.compareSync(password,u.password_hash))return res.status(401).json({error:'Invalid email or password'});res.json({token:tokenFor(u),user:publicUser(u)})}catch(e){res.status(500).json({error:e.message})}});
app.get('/api/bootstrap',auth,async(req,res)=>{try{const [u]=await pool.query('SELECT * FROM users');const [v]=await pool.query('SELECT * FROM venue_master ORDER BY name');const [a]=await pool.query('SELECT * FROM asset_master ORDER BY updated_at DESC');const [l]=await pool.query('SELECT id,venue_id,letter_date,file_name,mime_type,file_size,uploaded_by,created_at FROM asset_letters ORDER BY created_at DESC');const [me]=await pool.query('SELECT * FROM users WHERE id=?',[req.user.id]);res.json({users:u.map(publicUser),venues:v.map(normalizeVenue),assets:a.map(normalizeAsset),letters:l.map(x=>({...x,id:x.id,venueId:x.venue_id,letterDate:vDate(x.letter_date),fileName:x.file_name,mimeType:x.mime_type,fileSize:x.file_size,uploadedBy:x.uploaded_by,createdAt:x.created_at})),session:publicUser(me[0])})}catch(e){res.status(500).json({error:e.message})}});
function normalizeVenue(v){return {...v,id:v.id,venueId:v.venue_id,name:v.name,state:v.state,stateCode:v.state_code||'',district:v.district,districtCode:v.district_code||'',location:v.location||'',contact:v.contact||'',address:v.address||'',updatedBy:v.updated_by||'',createdBy:v.created_by||''}}
function normalizeAsset(a){return {...a,id:a.id,venueId:a.venue_id,assetType:a.asset_type,category:a.category,model:a.model_name||'',serial:a.serial_number||'',quantity:a.quantity,details:a.details||'',invoiceNo:a.invoice_no||'',invoiceDate:a.invoice_date?vDate(a.invoice_date):'',vendorName:a.vendor_name||'',removalDate:a.removal_date?vDate(a.removal_date):'',removed:!!a.removed,updatedBy:a.updated_by||'',createdBy:a.created_by||''}}
function vDate(x){return new Date(x).toISOString().slice(0,10)}
function cleanAsset(x,user){return {id:x.id||crypto.randomUUID(),venueId:x.venueId,assetType:x.assetType==='Rental'?'Rental':'Own',category:x.category,modelName:x.modelName??x.model??'',serialNumber:x.serialNumber??x.serial??'',quantity:Number(x.quantity||1),details:x.details||'',invoiceNo:x.invoiceNo||'',invoiceDate:x.invoiceDate||null,vendorName:x.vendorName||'',removalDate:x.removalDate||null,removed:x.removed?1:0,updatedBy:user?.name||user?.email||'',createdBy:x.createdBy||user?.name||user?.email||''}}
app.post('/api/sync/:resource',auth,async(req,res)=>{try{const r=req.params.resource,items=req.body;if(!Array.isArray(items))return res.status(400).json({error:'Expected an array'});if(r==='assets'){const [u]=await pool.query('SELECT * FROM users WHERE id=?',[req.user.id]);for(const x of items){const z=cleanAsset(x,u[0]);await pool.query(`INSERT INTO asset_master(id,venue_id,asset_type,category,model_name,serial_number,quantity,details,invoice_no,invoice_date,vendor_name,removal_date,removed,updated_by,created_by) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?) ON DUPLICATE KEY UPDATE venue_id=VALUES(venue_id),asset_type=VALUES(asset_type),category=VALUES(category),model_name=VALUES(model_name),serial_number=VALUES(serial_number),quantity=VALUES(quantity),details=VALUES(details),invoice_no=VALUES(invoice_no),invoice_date=VALUES(invoice_date),vendor_name=VALUES(vendor_name),removal_date=VALUES(removal_date),removed=VALUES(removed),updated_by=VALUES(updated_by)`,[z.id,z.venueId,z.assetType,z.category,z.modelName,z.serialNumber,z.quantity,z.details,z.invoiceNo,z.invoiceDate||null,z.vendorName,z.removalDate||null,z.removed,z.updatedBy,z.createdBy])}return res.json({ok:true,count:items.length})}if(r==='venues'){for(const x of items)await upsertVenue(x.id||crypto.randomUUID(),x);return res.json({ok:true,count:items.length})}if(r==='users'&&req.user.role==='Admin'){for(const x of items){const h=x.passwordHash||bcrypt.hashSync(String(x.password||'admin123'),10);await pool.query(`INSERT INTO users(id,name,email,password_hash,role,permissions) VALUES(?,?,?,?,?,?) ON DUPLICATE KEY UPDATE name=VALUES(name),email=VALUES(email),role=VALUES(role),permissions=VALUES(permissions)`,[x.id,x.name||'',String(x.email||x.username||'').toLowerCase(),h,x.role||'Support',JSON.stringify(x.permissions||[])] )}return res.json({ok:true,count:items.length})}return res.status(403).json({error:'Unsupported resource'})}catch(e){res.status(500).json({error:e.message})}});
app.post('/api/venues/save',auth,async(req,res)=>{try{const x=req.body;await upsertVenue(x.id||crypto.randomUUID(),{...x,updatedBy:req.user.email});res.json({ok:true})}catch(e){res.status(500).json({error:e.message})}});
app.post('/api/assets/save',auth,async(req,res)=>{try{const [u]=await pool.query('SELECT * FROM users WHERE id=?',[req.user.id]);const x=cleanAsset(req.body,u[0]);if(!x.venueId||!x.category)return res.status(400).json({error:'Venue and category are required'});if(x.quantity<1||x.quantity>25)return res.status(400).json({error:'Quantity must be 1 to 25'});if(x.assetType==='Own'&&!x.serialNumber)return res.status(400).json({error:'Serial Number is mandatory for Own Asset'});const [vv]=await pool.query('SELECT id FROM venue_master WHERE id=?',[x.venueId]);if(!vv.length)return res.status(400).json({error:'Invalid venue'});const q=`INSERT INTO asset_master(id,venue_id,asset_type,category,model_name,serial_number,quantity,details,invoice_no,invoice_date,vendor_name,removal_date,removed,updated_by,created_by) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?) ON DUPLICATE KEY UPDATE venue_id=VALUES(venue_id),asset_type=VALUES(asset_type),category=VALUES(category),model_name=VALUES(model_name),serial_number=VALUES(serial_number),quantity=VALUES(quantity),details=VALUES(details),invoice_no=VALUES(invoice_no),invoice_date=VALUES(invoice_date),vendor_name=VALUES(vendor_name),removal_date=VALUES(removal_date),removed=VALUES(removed),updated_by=VALUES(updated_by)`;await pool.query(q,[x.id,x.venueId,x.assetType,x.category,x.modelName,x.serialNumber,x.quantity,x.details,x.invoiceNo,x.invoiceDate||null,x.vendorName,x.removalDate||null,x.removed,x.updatedBy,x.createdBy]);res.json({ok:true})}catch(e){res.status(500).json({error:e.message})}});
app.delete('/api/assets/:id',auth,async(req,res)=>{try{await pool.query('DELETE FROM asset_master WHERE id=?',[req.params.id]);res.json({ok:true})}catch(e){res.status(500).json({error:e.message})}});
app.get('/api/letters',auth,async(req,res)=>{try{const [r]=await pool.query('SELECT id,venue_id,letter_date,file_name,mime_type,file_size,uploaded_by,created_at FROM asset_letters ORDER BY created_at DESC');res.json(r.map(x=>({...x,id:x.id,venueId:x.venue_id,letterDate:vDate(x.letter_date),fileName:x.file_name,mimeType:x.mime_type,fileSize:x.file_size,uploadedBy:x.uploaded_by,createdAt:x.created_at}))) }catch(e){res.status(500).json({error:e.message})}});
app.get('/api/letters/:id/download',auth,async(req,res)=>{try{const [r]=await pool.query('SELECT * FROM asset_letters WHERE id=?',[req.params.id]);if(!r.length)return res.sendStatus(404);res.setHeader('Content-Type',r[0].mime_type||'application/octet-stream');res.setHeader('Content-Disposition',`attachment; filename="${String(r[0].file_name).replace(/"/g,'') }"`);res.send(r[0].file_data)}catch(e){res.status(500).json({error:e.message})}});
app.post('/api/letters',auth,async(req,res)=>{try{const {venueId,letterDate,fileName,mimeType,fileData}=req.body||{};if(!venueId||!letterDate||!fileName||!fileData)return res.status(400).json({error:'Venue, date and file are required'});const b64=String(fileData).replace(/^data:[^;]+;base64,/,'');const buf=Buffer.from(b64,'base64');if(!buf.length)return res.status(400).json({error:'Invalid file'});if(buf.length>30*1024*1024)return res.status(400).json({error:'Maximum file size is 30 MB'});await pool.query('INSERT INTO asset_letters(id,venue_id,letter_date,file_name,mime_type,file_size,file_data,uploaded_by) VALUES(?,?,?,?,?,?,?,?)',[crypto.randomUUID(),venueId,letterDate,fileName,mimeType||'application/octet-stream',buf.length,buf,req.user.email]);res.json({ok:true})}catch(e){res.status(500).json({error:e.message})}});
app.delete('/api/letters/:id',auth,async(req,res)=>{try{await pool.query('DELETE FROM asset_letters WHERE id=?',[req.params.id]);res.json({ok:true})}catch(e){res.status(500).json({error:e.message})}});
app.get('/api/reports/state',auth,async(req,res)=>{try{const [r]=await pool.query(`SELECT v.state AS state,COUNT(DISTINCT v.id) total_venues,COALESCE(SUM(a.quantity),0) total_assets FROM venue_master v LEFT JOIN asset_master a ON a.venue_id=v.id AND a.removed=0 GROUP BY v.state ORDER BY v.state`);res.json(r)}catch(e){res.status(500).json({error:e.message})}});
app.get('/api/reports/district',auth,async(req,res)=>{try{const [r]=await pool.query(`SELECT v.state AS state,v.district AS district,COUNT(DISTINCT v.id) total_venues,COALESCE(SUM(a.quantity),0) total_assets FROM venue_master v LEFT JOIN asset_master a ON a.venue_id=v.id AND a.removed=0 GROUP BY v.state,v.district ORDER BY v.state,v.district`);res.json(r)}catch(e){res.status(500).json({error:e.message})}});
app.get('/api/venues/:id/assets',auth,async(req,res)=>{try{const [r]=await pool.query('SELECT * FROM asset_master WHERE venue_id=? ORDER BY updated_at DESC',[req.params.id]);res.json(r.map(normalizeAsset))}catch(e){res.status(500).json({error:e.message})}});
app.listen(PORT,'0.0.0.0',async()=>{try{await initDb();console.log(`Venue Asset Manager API running on http://0.0.0.0:${PORT}`)}catch(e){console.error('Database initialization failed',e)}});
