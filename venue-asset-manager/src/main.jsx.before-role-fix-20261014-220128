  function Calculator(){
  const [amount,setAmount]=useState('');
  const [rate,setRate]=useState('5');

  const gross=Number(amount)||0;
  const selectedRate=Number(rate)||0;

  // Fixed default deduction
  const defaultDeduction = gross > 0 ? 5 : 0;

  // GST including calculation
  const gst=selectedRate>0
    ? gross*selectedRate/(100+selectedRate)
    : 0;

  // CGST and SGST
  const cgst=gst/2;
  const sgst=gst/2;

  // Net amount:
  // Total Amount - Default &#8377;5 - Total GST
  const net=gross-defaultDeduction-gst;

  const money=(value)=>{
    return Number(value||0).toFixed(2);
  };

  return (
    <Page
      title="Theatre GST Calculator"
      sub="GST including calculation for theatre operations"
    >

      <div className="panel">

        <div className="formgrid">

          <label>
            Total Amount
            <input
              type="number"
              min="0"
              step="0.01"
              value={amount}
              onChange={e=>setAmount(e.target.value)}
              placeholder="Enter total amount"
            />
          </label>

          <label>
            GST Rate
            <select
              value={rate}
              onChange={e=>setRate(e.target.value)}
            >
              <option value="5">5%</option>
              <option value="12">12%</option>
              <option value="18">18%</option>
              <option value="36">36%</option>
              <option value="40">40%</option>
            </select>
          </label>

          <label>
            Default Deduction
            <input
              type="text"
              value={'\u20B95.00'}
              readOnly
            />
          </label>

        </div>

        <div
          style={{
            display:'grid',
            gridTemplateColumns:'repeat(auto-fit,minmax(180px,1fr))',
            gap:'12px',
            marginTop:'20px'
          }}
        >

          <div className="panel">
            <div>Total Amount</div>
            <strong>&#8377; {money(gross)}</strong>
          </div>

          <div className="panel">
            <div>GST Rate</div>
            <strong>{selectedRate}%</strong>
          </div>

          <div className="panel">
            <div>GST Amount</div>
            <strong>&#8377; {money(gst)}</strong>
          </div>

          <div className="panel">
            <div>CGST</div>
            <strong>&#8377; {money(cgst)}</strong>
          </div>

          <div className="panel">
            <div>SGST</div>
            <strong>&#8377; {money(sgst)}</strong>
          </div>

          <div className="panel">
            <div>Default Deduction</div>
            <strong>&#8377; {money(defaultDeduction)}</strong>
          </div>

          <div className="panel">
            <div>Net Amount</div>
            <strong>&#8377; {money(net)}</strong>
          </div>

        </div>

        <div
          className="panel"
          style={{marginTop:'16px'}}
        >

          <h3>Calculation</h3>

          <div style={{marginBottom:'8px'}}>
            GST = &#8377;{money(gross)} &#215; {selectedRate} &#247;
            (100 + {selectedRate})
          </div>

          <div style={{marginBottom:'8px'}}>
            GST = &#8377;{money(gst)}
          </div>

          <div style={{marginBottom:'8px'}}>
            CGST = &#8377;{money(gst)} &#247; 2 = &#8377;{money(cgst)}
          </div>

          <div style={{marginBottom:'8px'}}>
            SGST = &#8377;{money(gst)} &#247; 2 = &#8377;{money(sgst)}
          </div>

          <div style={{marginBottom:'8px'}}>
            Net Amount = &#8377;{money(gross)} - &#8377;5 - &#8377;{money(gst)}
            = &#8377;{money(net)}
          </div>

        </div>

      </div>

    </Page>
  );
}

function UsersPage(){
  const session=normalizeUser(get('vam_session',{}));
  const [rows,setRows]=useState(()=>users());
  const [show,setShow]=useState(false);
  const [edit,setEdit]=useState(null);
  const [search,setSearch]=useState('');
  const closeUserModal=()=>{
    setShow(false);
    setEdit(null);
  };

  const empty={
    id:'',
    name:'',
    email:'',
    password:'',
    role:'Support',
    permissions:ROLE_ACCESS.Support
  };

  if(session?.role!=='Admin'){
    return (
      <Page
        title="Users"
        sub="User management"
      >
        <div className="panel">
          <div className="err">
            Only Administrator can manage users.
          </div>
        </div>
      </Page>
    );
  }

  const openAdd=()=>{
    setEdit({...empty});
    setShow(true);
  };

  const openEdit=(u)=>{
    if(String(u.id)==='1'){
      return alert('Administrator account cannot be edited.');
    }

    setEdit({
      ...u,
      permissions:Array.isArray(u.permissions)
        ? [...u.permissions]
        : (ROLE_ACCESS[u.role]||ROLE_ACCESS.Support)
    });
    setShow(true);
};

  const saveUser=()=>{
    const name=String(edit.name||'').trim();
    const email=String(edit.email||'').trim().toLowerCase();
    const password=String(edit.password||'');
    const role=edit.role||'Support';

    if(!name)return alert('Name is required');
    if(!email)return alert('Email ID is required');

    if(!/^\S+@\S+\.\S+$/.test(email)){
      return alert('Enter a valid email ID');
    }

    if(!edit.id && (password.length<6 || password.length>10)){
      return alert('Password must be 6 to 10 characters');
    }

    const list=[...users()];

    const duplicate=list.find(x=>
      String(x.email||x.username||'').toLowerCase()===email &&
      String(x.id)!==String(edit.id)
    );

    if(duplicate){
      return alert('Email ID already exists');
    }

    const permissions=role==='Admin'
      ? APP_ACCESS.map(x=>x[0])
      : (Array.isArray(edit.permissions)
          ? edit.permissions
          : (ROLE_ACCESS[role]||ROLE_ACCESS.Support));

    const item={
      ...edit,
      id:edit.id||String(Date.now()),
      name,
      email,
      username:email,
      password:password || edit.password || '',
      role,
      permissions
    };

    const next=edit.id
      ? list.map(x=>String(x.id)===String(edit.id)?item:x)
      : [...list,item];

    put('vam_users',next);
    setRows(next);
    setShow(false);
    setEdit(null);
  };

  const removeUser=(u)=>{
    if(String(u.id)==='1'){
      return alert('Administrator account cannot be deleted.');
    }

    if(String(u.role)==='Admin'){
      const adminCount=rows.filter(x=>x.role==='Admin').length;
      if(adminCount<=1){
        return alert('At least one Administrator account must remain.');
      }
    }

    if(!confirm('Delete user '+u.email+'?'))return;

    const next=rows.filter(x=>String(x.id)!==String(u.id));
    put('vam_users',next);
    setRows(next);
  };

