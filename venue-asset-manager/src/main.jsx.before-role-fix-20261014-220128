function pdfEscape(value){return String(value??'').replace(/\\/g,'\\\\').replace(/\(/g,'\\(').replace(/\)/g,'\\)').replace(/\r?\n/g,' ')}
function downloadSimplePDF(title,headers,rows,filename){
  const esc=pdfEscape;
  const pageW=842,pageH=595,margin=28,top=555,bottom=28;
  const usableW=pageW-margin*2;
  const weights=headers.map((h,i)=>Math.max(String(h).length,...rows.map(r=>String(r[i]??'').length),4));
  const total=weights.reduce((a,b)=>a+b,0);
  const widths=weights.map(w=>usableW*w/total);
  const fontSize=8,lineH=11,cellPad=4,headerH=22;
  const wrap=(value,maxChars)=>{const t=String(value??'');if(!t)return [''];const out=[];let rest=t;while(rest.length>maxChars){let cut=rest.lastIndexOf(' ',maxChars);if(cut<1)cut=maxChars;out.push(rest.slice(0,cut));rest=rest.slice(cut).trim()}out.push(rest);return out};
  const prepared=rows.map(r=>r.map((v,i)=>wrap(v,Math.max(4,Math.floor((widths[i]-cellPad*2)/(fontSize*0.52))))));
  const pages=[];let current=[];let y=top-48;
  const rowHeight=lines=>Math.max(headerH,lines*lineH+cellPad*2);
  for(let i=0;i<prepared.length;i++){
    const h=rowHeight(Math.max(...prepared[i].map(x=>x.length)));
    if(y-h<bottom+28 && current.length){pages.push(current);current=[];y=top-48}
    current.push({row:prepared[i],height:h});y-=h;
  }
  if(current.length||!pages.length)pages.push(current);
  const objs=[];const add=o=>{objs.push(o);return objs.length};
  const font=add('<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>');
  const pageIds=[],contentIds=[];
  pages.forEach((items,pageIndex)=>{
    let stream='q\n';
    stream+=`BT\n/F1 15 Tf\n${margin} ${top} Td\n(${esc(title)}) Tj\nET\n`;
    stream+=`BT\n/F1 8 Tf\n${margin} ${top-16} Td\n(Generated: ${esc(new Date().toLocaleString())}) Tj\nET\n`;
    let y=top-48;
    const xPositions=[margin];for(const w of widths)xPositions.push(xPositions[xPositions.length-1]+w);
    // Header background and border
    stream+=`0.93 g ${margin} ${y-headerH} ${usableW} ${headerH} re f 0 g\n`;
    stream+=`0.55 w ${margin} ${y-headerH} ${usableW} ${headerH} re S\n`;
    stream+='BT\n/F1 8 Tf\n';
    headers.forEach((h,i)=>{const tx=xPositions[i]+cellPad,ty=y-15;stream+=`1 0 0 1 ${tx} ${ty} Tm (${esc(h)}) Tj\n`});
    stream+='ET\n';
    // Header vertical lines
    for(let i=1;i<xPositions.length-1;i++)stream+=`0.55 w ${xPositions[i]} ${y-headerH} m ${xPositions[i]} ${y} l S\n`;
    y-=headerH;
    // Data rows with full grid lines
    items.forEach(item=>{
      const h=item.height;
      stream+=`0.55 w ${margin} ${y-h} ${usableW} ${h} re S\n`;
      for(let i=1;i<xPositions.length-1;i++)stream+=`${xPositions[i]} ${y-h} m ${xPositions[i]} ${y} l S\n`;
      stream+='BT\n/F1 8 Tf\n';
      item.row.forEach((cell,i)=>{
        cell.forEach((line,j)=>{const tx=xPositions[i]+cellPad,ty=y-cellPad-9-j*lineH;stream+=`1 0 0 1 ${tx} ${ty} Tm (${esc(line)}) Tj\n`});
      });
      stream+='ET\n';
      y-=h;
    });
    stream+=`BT\n/F1 7 Tf\n${margin} 14 Td\n(Page ${pageIndex+1} of ${pages.length}) Tj\nET\nQ`;
    const cid=add(`<< /Length ${stream.length} >>\nstream\n${stream}\nendstream`);contentIds.push(cid);pageIds.push(add(''));
  });
  const pagesId=add('');const catalogId=add('');
  pageIds.forEach((pid,i)=>{objs[pid-1]=`<< /Type /Page /Parent ${pagesId} 0 R /MediaBox [0 0 ${pageW} ${pageH}] /Resources << /Font << /F1 ${font} 0 R >> >> /Contents ${contentIds[i]} 0 R >>`});
  objs[pagesId-1]=`<< /Type /Pages /Kids [${pageIds.map(id=>id+' 0 R').join(' ')}] /Count ${pageIds.length} >>`;
  objs[catalogId-1]=`<< /Type /Catalog /Pages ${pagesId} 0 R >>`;
  let pdf='%PDF-1.4\n',offsets=[0];objs.forEach((o,i)=>{offsets[i+1]=pdf.length;pdf+=(i+1)+' 0 obj\n'+o+'\nendobj\n'});
  const xref=pdf.length;pdf+='xref\n0 '+(objs.length+1)+'\n0000000000 65535 f \n';for(let i=1;i<offsets.length;i++)pdf+=String(offsets[i]).padStart(10,'0')+' 00000 n \n';pdf+=`trailer\n<< /Size ${objs.length+1} /Root ${catalogId} 0 R >>\nstartxref\n${xref}\n%%EOF`;
  const blob=new Blob([pdf],{type:'application/pdf'}),url=URL.createObjectURL(blob),link=document.createElement('a');link.href=url;link.download=filename;document.body.appendChild(link);link.click();link.remove();setTimeout(()=>URL.revokeObjectURL(url),1000);
}
function Reports(){
  const [view,setView]=useState('state');
  const [rows,setRows]=useState([]);
  const [busy,setBusy]=useState(false);
  const [err,setErr]=useState('');
  const [from,setFrom]=useState('');
  const [to,setTo]=useState('');
  const [user,setUser]=useState('');
  const [role,setRole]=useState('');
  const [module,setModule]=useState('');
  const [action,setAction]=useState('');
  const [search,setSearch]=useState('');
  const closeUserModal=()=>{
    setShow(false);
    setEdit(null);
  };
  const token=localStorage.getItem('vam_token')||'';

  const configs={
    state:{title:'State-wise Report',heads:['State / UT','Venues','Asset Quantity'],url:'/api/reports/state'},
    district:{title:'District-wise Report',heads:['State / UT','District','Venues','Asset Quantity'],url:'/api/reports/district'},
    venue:{title:'Venue-wise Report',heads:['State / UT','District','Venue ID','Venue Name','Asset Records','Asset Quantity'],url:'/api/reports/venue'},
    user:{title:'User-wise Report',heads:['User','Email','Role','Activities','Last Activity'],url:'/api/reports/user'},
    asset:{title:'Asset-wise Report',heads:['Venue ID','Venue Name','Asset ID','Asset Type','Category','Model','Serial','Invoice No','Invoice Date','Vendor','Qty','Status','Removal Asset','Removal Date'],url:'/api/reports/asset'},
    letters:{title:'Asset Letters Report',heads:['Venue ID','Venue Name','Letter Date','File Name','MIME','Size','Uploaded By','Created At'],url:'/api/reports/letters'},
    swapping:{title:'Swapping Report',heads:['Date / Time','Asset ID','From Venue','To Venue','Asset Type','Category','Model','Serial','Qty','Swapped By'],url:'/api/reports/swapping'},
    activity:{title:'User Activity Log',heads:['Date / Time','User','Email','Role','Action','Module','Details','IP Address'],url:'/api/reports/user-log'}
  };

  const load=async()=>{
    setBusy(true);setErr('');
    try{
      const c=configs[view];
      const qs=new URLSearchParams();
      if(view==='activity'){
        if(from)qs.set('from',from);
        if(to)qs.set('to',to);
        if(user)qs.set('user',user);
        if(role)qs.set('role',role);
        if(module)qs.set('module',module);
        if(action)qs.set('action',action);
        if(search)qs.set('search',search);
      }
      const r=await fetch(`${API_BASE}${c.url}${qs.toString()?'?'+qs.toString():''}`,{headers:{Authorization:`Bearer ${token}`}});
      const d=await r.json();
      if(!r.ok)throw new Error(d.error||'Unable to load report');
      setRows(Array.isArray(d)?d:[]);
    }catch(e){setRows([]);setErr(e.message||'Unable to load report')}
    finally{setBusy(false)}
  };

  useEffect(()=>{load()},[view,from,to,user,role,module,action,search]);

  const dataRows=rows.map(x=>{
    if(view==='state')return [x.state||'-',x.total_venues||0,x.total_assets||0];
    if(view==='district')return [x.state||'-',x.district||'-',x.total_venues||0,x.total_assets||0];
    if(view==='venue')return [x.state||'-',x.district||'-',x.venue_id||'-',x.venue_name||'-',x.asset_records||0,x.asset_quantity||0];
    if(view==='user')return [x.user_name||'-',x.email||'-',x.role||'-',x.activities||0,x.last_activity||'-'];
    if(view==='asset')return [x.venue_id||'-',x.venue_name||'-',x.asset_id||'-',x.asset_type||'-',x.category||'-',x.model_name||'-',x.serial_number||'-',x.invoice_no||'-',x.invoice_date||'-',x.vendor_name||'-',x.quantity||0,x.status||'-',x.removal_asset?'Yes':'No',x.removal_date||'-'];
    if(view==='letters')return [x.venue_id||'-',x.venue_name||'-',x.letter_date||'-',x.file_name||'-',x.mime_type||'-',`${x.file_size||0} bytes`,x.uploaded_by||'-',x.created_at||'-'];
    if(view==='swapping')return [x.swapped_at||'-',x.asset_id||'-',x.from_venue||x.from_venue_id||'-',x.to_venue||x.to_venue_id||'-',x.asset_type||'-',x.category||'-',x.model_name||'-',x.serial_number||'-',x.quantity||0,x.swapped_by||'-'];
    return [x.created_at||'-',x.user_name||'-',x.email||'-',x.role||'-',x.action||'-',x.module||'-',x.details||'-',x.ip_address||'-'];
  });

  const csv=()=>{
    const content=[configs[view].heads,...dataRows].map(r=>r.map(v=>`"${String(v??'').replaceAll('"','""')}"`).join(',')).join('\n');
    const u=URL.createObjectURL(new Blob([content],{type:'text/csv;charset=utf-8;'})),a=document.createElement('a');
    a.href=u;a.download=`venue-asset-${view}-report.csv`;a.click();URL.revokeObjectURL(u);
  };
  const pdf=()=>downloadSimplePDF(`Venue Asset Manager - ${configs[view].title}`,configs[view].heads,dataRows,`venue-asset-${view}-report.pdf`);

  return <Page title="Reports" sub="MySQL reports - State, District, Venue, User, Asset, Letters, Swapping and Activity" action={
    <div className="report-actions"><button className="btn" onClick={csv}><Download size={16}/>Export CSV</button><button className="primary" onClick={pdf}><Download size={16}/>Download PDF</button></div>
  }>
    <div className="report-selector">
      <b>Report</b>
      <select value={view} onChange={e=>setView(e.target.value)}>
        <option value="state">1. State-wise</option>
        <option value="district">2. District-wise</option>
        <option value="venue">3. Venue-wise</option>
        <option value="user">4. User-wise</option>
        <option value="asset">5. Asset-wise</option>
        <option value="letters">6. Asset Letters</option>
        <option value="swapping">7. Swapping Report</option>
        <option value="activity">8. User Activity Log</option>
      </select>
    </div>
    {view==='activity'&&<section className="panel">
      <div className="form">
        <label>Date From<input type="date" value={from} onChange={e=>setFrom(e.target.value)}/></label>
        <label>Date To<input type="date" value={to} onChange={e=>setTo(e.target.value)}/></label>
        <label>User<input value={user} onChange={e=>setUser(e.target.value)} placeholder="User / email"/></label>
        <label>Role<input value={role} onChange={e=>setRole(e.target.value)} placeholder="Role"/></label>
        <label>Module<input value={module} onChange={e=>setModule(e.target.value)} placeholder="Module"/></label>
        <label>Action<input value={action} onChange={e=>setAction(e.target.value)} placeholder="Action"/></label>
        <label className="wide">Search<input value={search} onChange={e=>setSearch(e.target.value)} placeholder="Search activity details"/></label>
      </div>
    </section>}
    {err&&<div className="err">{err}</div>}
    {busy?<div className="empty">Loading report...</div>:<section className="panel"><h2>{configs[view].title}</h2><Table heads={configs[view].heads} rows={dataRows}/>{!dataRows.length&&<div className="empty">No records found.</div>}</section>}
  </Page>
}

function App(){const[ready,setReady]=useState(false);useEffect(()=>{
 const send=(entry)=>{try{const payload={source:'frontend',level:entry.level||'error',type:String(entry.type||'javascript').slice(0,80),message:String(entry.message||'Unknown error').slice(0,2000),page:location.pathname.slice(0,300),stack:String(entry.stack||'').slice(0,6000),status:entry.status??null};fetch(`${API_BASE}/api/logs/client`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload),keepalive:true}).catch(()=>{})}catch{}};
 const onError=e=>send({type:'window.error',message:e.message||'JavaScript error',stack:e.error?.stack||''});
 const onReject=e=>send({type:'unhandledrejection',message:e.reason?.message||String(e.reason||'Unhandled promise rejection'),stack:e.reason?.stack||''});
 window.addEventListener('error',onError);window.addEventListener('unhandledrejection',onReject);
 const originalFetch=window.fetch.bind(window);
 window.fetch=async(...args)=>{const input=args[0],url=typeof input==='string'?input:(input?.url||'');try{const response=await originalFetch(...args);if(!String(url).includes('/api/logs/client')&&!response.ok&&String(url).includes('/api/'))send({type:'api.http_error',message:`API request failed: ${response.status} ${response.statusText}`,status:response.status});return response}catch(err){if(!String(url).includes('/api/logs/client')&&String(url).includes('/api/'))send({type:'api.network_error',message:err?.message||'API network request failed',stack:err?.stack||''});throw err}};
 return ()=>{window.removeEventListener('error',onError);window.removeEventListener('unhandledrejection',onReject);window.fetch=originalFetch};
},[]);useEffect(()=>{(async()=>{if(localStorage.getItem('vam_token')){try{await hydrateFromServer()}catch{localStorage.removeItem('vam_token');localStorage.removeItem('vam_session')}}setReady(true)})()},[]);if(!ready)return <div className="login"><div className="loginbox"><div className="logo">VA</div><h1>Venue Asset Manager</h1><p>Connecting to serverÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¦</p></div></div>;return <Routes><Route path="/login" element={<Login/>}/><Route path="*" element={get('vam_session')?<Layout/>:<Navigate to="/login"/>}/></Routes>}

