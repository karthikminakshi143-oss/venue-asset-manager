function VenueAssetSwapping({close}){
  const swapUser=get('vam_session',{});
  const venues=get('vam_venues',[]);
  const [currentVenue,setCurrentVenue]=useState('');
  const [newVenue,setNewVenue]=useState('');
  const [assets,setAssets]=useState([]);
  const [selected,setSelected]=useState([]);
  const [loading,setLoading]=useState(false);
  const [busy,setBusy]=useState(false);

  const token=get('vam_token','');

  const loadAssets=async(id)=>{
    setCurrentVenue(id);
    setSelected([]);
    setAssets([]);

    if(!id) return;

    setLoading(true);

    try{
      const r=await fetch(API_BASE + '/api/assets/venue-swap/'+encodeURIComponent(id),{
        headers:{Authorization:'Bearer '+token}
      });

      const data=await r.json();

      if(!r.ok){
        throw new Error(data.error||'Unable to load assets');
      }

      setAssets(Array.isArray(data.assets)?data.assets:[]);
    }catch(e){
      alert(e.message);
    }finally{
      setLoading(false);
    }
  };

  const toggle=id=>{
    setSelected(s =>
      s.includes(id)
        ? s.filter(x=>x!==id)
        : [...s,id]
    );
  };

  const selectAll=()=>{
    if(selected.length===assets.length){
      setSelected([]);
    }else{
      setSelected(assets.map(x=>x.id));
    }
  };

  const transfer=async()=>{
    if(!currentVenue){
      return alert('Select Current Venue ID');
    }

    if(!newVenue){
      return alert('Select New Venue ID');
    }

    if(currentVenue===newVenue){
      return alert('Current Venue and New Venue cannot be the same');
    }

    if(!selected.length){
      return alert('Select at least one asset');
    }

    const current=venues.find(x=>x.id===currentVenue);
    const target=venues.find(x=>x.id===newVenue);

    const confirmed=confirm(
      'Transfer '+selected.length+
      ' selected asset(s) from '+
      (current?.venueId||current?.name||currentVenue)+
      ' to '+
      (target?.venueId||target?.name||newVenue)+
      '?'
    );

    if(!confirmed) return;

    setBusy(true);

    try{
      const r=await fetch(API_BASE + '/api/assets/venue-swap',{
        method:'POST',
        headers:{
          'Content-Type':'application/json',
          Authorization:'Bearer '+token
        },
        body:JSON.stringify({
          currentVenueId:currentVenue,
          newVenueId:newVenue,
          assetIds:selected,
          swappedBy:swapUser?.name||swapUser?.email||'Unknown'
        })
      });

      const data=await r.json();

      if(!r.ok){
        throw new Error(data.error||'Venue asset transfer failed');
      }

      const local=get('vam_assets',[]);

      const updated=local.map(x =>
        selected.includes(x.id)
          ? {
