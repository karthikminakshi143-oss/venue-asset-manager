function extractList(payload){
  if(Array.isArray(payload))return payload;
  if(!payload||typeof payload!=='object')return [];
  for(const k of ['data','result','results','records','items','districts','districtList','response']){
    if(Array.isArray(payload[k]))return payload[k];
    if(payload[k]&&typeof payload[k]==='object'){
      for(const kk of ['data','result','results','districts','districtList'])if(Array.isArray(payload[k][kk]))return payload[k][kk];
    }
  }
  for(const v of Object.values(payload))if(Array.isArray(v))return v;
  return [];
}

function parseDistricts(text){
  try{return extractList(JSON.parse(text));}catch{}
  if(typeof DOMParser!=='undefined' && /<[^>]+>/.test(text)){
    const xml=new DOMParser().parseFromString(text,'application/xml');
    return [...xml.querySelectorAll('item,District,district')].map(node=>{
      const attrs=Object.fromEntries([...node.attributes].map(a=>[a.name,a.value]));
      const children=Object.fromEntries([...node.children].map(c=>[c.tagName,c.textContent.trim()]));
      return {...attrs,...children};
    });
  }
  return [];
}

async function getDistricts(stateCode){
  const code=STATE_CODES[stateCode]||stateCode;
  if(!code)return [];
  const r=await fetch('/lgd-api/districtList?stateCode='+encodeURIComponent(code),{method:'POST',headers:{Accept:'application/json, text/plain, */*','Content-Type':'application/json'},body:'{}'});
  if(!r.ok)throw new Error('District request failed: '+r.status);
  const a=parseDistricts(await r.text());
  return a.map(x=>({
    code:String(x.code??x.lgdCode??x.entityCode??x.entityLGDCode??x.districtCode??x.district_code??x.DistrictCode??x.DISTRICT_CODE??''),
    name:String(x.name??x.entityName??x.districtName??x.districtNameEnglish??x.district_name??x.district_name_english??x.DistrictName??x.DISTRICT_NAME??x.DISTRICT_NAME_ENGLISH??'').trim()
  })).filter(x=>x.name).map(x=>({...x,code:x.code||x.name})).sort((a,b)=>a.name.localeCompare(b.name));
}

